{
  "storage": { "rules": "web-functions/storage.rules" },
  "database": { "rules": "web-functions/database.rules.json" },
  "functions": [
    {
      "source": "web-functions",
      "codebase": "web-backend",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        ".env",
        ".env.*",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
