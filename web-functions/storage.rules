rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && 'admin' in request.auth.token && request.auth.token.admin == true;
    }

    function validDocument() {
      return request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png'];
    }

    match /premium_uploads/{requestId}/{fileName} {
      allow read: if isAdmin();
      allow create: if resource == null && request.auth != null
        && requestId.matches('PIN-[0-9]{6}')
        && request.resource.metadata.ownerUid == request.auth.uid
        && validDocument();
      allow update: if false;
      allow delete: if isAdmin() || (request.auth != null
        && resource.metadata.ownerUid == request.auth.uid);
    }

    match /final_reports/{fileName} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
